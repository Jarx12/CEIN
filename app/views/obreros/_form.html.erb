<style>
    .form-container {
        max-width: 650px;
        margin: 40px auto;
    }
    .card-worker {
        border-radius: 1.25rem;
        border: none;
    }
    /* Teal branding for Operational Staff */
    .text-teal { color: #20c997 !important; }
    .bg-teal-subtle { background-color: #e6fcf5 !important; }
    
    .form-label {
        font-size: 0.9rem;
        margin-bottom: 0.4rem;
    }
    .form-control, .form-select {
        border-radius: 0.75rem;
        padding: 0.65rem 1rem;
        border: 1px solid #ced4da;
    }
    .form-control:focus, .form-select:focus {
        border-color: #20c997;
        box-shadow: 0 0 0 0.25rem rgba(32, 201, 151, 0.1);
    }
    .error-box {
        background-color: #fff5f5;
        border-left: 4px solid #e53e3e;
        border-radius: 0.75rem;
    }
</style>

<div class="container form-container">
    <%# Validation Feedback %>
    <% if @obrero.errors.any? %>
      <div class="error-box p-4 mb-4 shadow-sm">
        <h5 class="text-danger fw-bold">⚠️ Hay errores en el formulario:</h5>
        <ul class="mb-0 small text-danger">
          <% @obrero.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="card card-worker shadow-lg p-4 p-md-5">
        <div class="text-center mb-4">
            <div class="bg-teal-subtle text-teal rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                <span style="font-size: 1.8rem;">👷</span>
            </div>
            <h2 class="fw-bold text-dark mb-1"><%= tipo %></h2>
            <p class="text-muted">Personal de Servicios y Mantenimiento</p>
        </div>

        <%= form_with model: obrero, local: true do |form| %>
            <div class="row g-3">
                <%# Row 1: Names %>
                <div class="col-md-6">
                    <%= form.label :name, "Primer Nombre", class: "form-label fw-bold text-secondary" %>
                    <%= form.text_field :name, class: 'form-control', placeholder: 'Ej. Alberto', required: true %>
                </div>
                <div class="col-md-6">
                    <%= form.label :name2, "Segundo Nombre", class: "form-label fw-bold text-secondary" %>
                    <%= form.text_field :name2, class: 'form-control', placeholder: 'Ej. Jesús' %>
                </div>

                <%# Row 2: Last Names %>
                <div class="col-md-6">
                    <%= form.label :apellido, "Primer Apellido", class: "form-label fw-bold text-secondary" %>
                    <%= form.text_field :apellido, class: 'form-control', placeholder: 'Ej. Suarez', required: true %>
                </div>
                <div class="col-md-6">
                    <%= form.label :apellido2, "Segundo Apellido", class: "form-label fw-bold text-secondary" %>
                    <%= form.text_field :apellido2, class: 'form-control', placeholder: 'Ej. Castillo' %>
                </div>

                <%# Row 3: ID and Phone %>
                <div class="col-md-6">
                    <%= form.label :cedula, "Cédula de Identidad", class: "form-label fw-bold text-secondary" %>
                    <%= form.text_field :cedula, class: 'form-control', placeholder: '12345678', required: true %>
                </div>
                <div class="col-md-6">
                    <%= form.label :telefono, "Teléfono", class: "form-label fw-bold text-secondary" %>
                    <%= form.text_field :telefono, class: 'form-control', placeholder: '04261231705', required: true %>
                </div>

                <%# Row 4: Birthday and Cargo %>
                <div class="col-md-6">
                    <%= form.label :birthday, "Fecha de Nacimiento", class: "form-label fw-bold text-secondary" %>
                    <%= form.date_field :birthday, class: 'form-control', required: true %>
                </div>
                <div class="col-md-6">
                    <%= form.label :cargo_id, "Cargo Asignado", class: "form-label fw-bold text-secondary" %>
                    <%= form.collection_select :cargo_id, Cargo.all, :id, :nombre_cargo, 
                        { prompt: "Seleccione un área..." }, 
                        { class: "form-select", required: true } %>
                </div>
                <%# Row 5: Address %>
                <div class="col-12">
                    <%= form.label :direccion, "Dirección de Habitación", class: "form-label fw-bold text-secondary" %>
                    <%= form.text_area :direccion, rows: 2, class: 'form-control', placeholder: 'Av. principal, Calle...', required: true %>
                </div>
                <%# --- SECCIÓN: FICHA TÉCNICA --- %>
                <div class="col-12 mt-4">
                    <hr class="text-muted opacity-25">
                    <h5 class="fw-bold text-indigo mb-3">📋 Ficha Técnica</h5>
                </div>

                <%# ID Ministerio %>
                <div class="col-12">
                    <%= form.label :ministerio_id, "ID Nacional del Ministerio", class: "form-label fw-bold text-secondary" %>
                    <%= form.text_field :ministerio_id, class: 'form-control', placeholder: 'Ej. MPPE-12345678' %>
                </div>

                <%# Antecedentes Penales %>
                <div class="col-12">
                    <%= form.label :antecedentes_penales, "Antecedentes Penales", class: "form-label fw-bold text-secondary" %>
                    <%= form.file_field :antecedentes_penales, class: 'form-control', accept: 'image/*,application/pdf' %>
                    <div class="form-text small">Cargar comprobante (Imagen o PDF).</div>
                </div>
                <%# ------------------------------ %>
                <%# Action Buttons %>
                <div class="col-12 mt-4">
                    <%= form.submit "Guardar Registro", class: "btn btn-success btn-lg w-100 rounded-pill shadow-sm fw-bold py-3 mb-2" %>
                    <%= link_to "Cancelar y Volver", obreros_path, class: "btn btn-link w-100 text-muted text-decoration-none" %>
                </div>
            </div>
        <% end %>
    </div>
</div>