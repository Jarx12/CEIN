<style>
    /* --- Estilos Globales --- */
    body { background-color: #f4f7f6; font-family: 'Segoe UI', sans-serif; }
    .card-profile { border-radius: 1.5rem; max-width: 520px; margin: 40px auto; background: white; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.15); border: none; }
    
    /* Branding: Naranja/Ámbar para Obreros */
    .profile-header { background: linear-gradient(135deg, #f39c12, #e67e22); padding: 2.5rem; color: white; text-align: center; }
    
    .label-text { font-size: 0.7rem; text-transform: uppercase; color: #6c757d; font-weight: 800; margin-bottom: 2px; letter-spacing: 0.5px; }
    .data-text { color: #212529; font-weight: 500; margin-bottom: 1.2rem; font-size: 1rem; border-bottom: 1px solid #f8f9fa; padding-bottom: 4px; }
    .ficha-tecnica { background-color: #f8f9fa; border-radius: 1rem; padding: 1.5rem; border: 1px solid #eee; margin-top: 10px; }


    #modal-ante-toggle { display: none; }

    .modal-overlay {
        display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.92); z-index: 99999; justify-content: center; 
        align-items: center; padding: 20px; backdrop-filter: blur(8px); flex-direction: column;
    }

    #modal-ante-toggle:checked ~ .modal-ante-view { display: flex; }

    .btn-visualizar {
        display: inline-block; width: 100%; background: #e67e22; color: white !important;
        text-align: center; padding: 12px; border-radius: 10px; text-decoration: none;
        font-weight: bold; cursor: pointer; border: none; margin-bottom: 10px; transition: 0.3s;
    }
    .btn-visualizar:hover { background: #d35400; transform: translateY(-2px); }
    
    .img-fullscreen { max-width: 95%; max-height: 85vh; border: 4px solid white; border-radius: 8px; }
    .pdf-embed { border: 5px solid white; border-radius: 8px; background: white; }
    .btn-cerrar-modal { position: absolute; top: 25px; right: 25px; color: white; font-size: 35px; cursor: pointer; font-weight: bold; }
</style>

<%# --- CONTROL --- %>
<input type="checkbox" id="modal-ante-toggle">

<div class="container pb-5">
    <div class="card card-profile">
        <div class="profile-header text-center">
            <div class="bg-white text-warning rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 80px; height: 80px; font-size: 2.5rem;">
                🛠️
            </div>
            <h2 class="fw-bold mb-0"><%= @obrero.name %> <%= @obrero.apellido %></h2>
            <p class="mb-0 opacity-75">Personal Obrero / Mantenimiento</p>
        </div>

        <div class="card-body p-4">
            <div class="row text-start">
                <div class="col-12 mb-3 text-center">
                    <div class="badge bg-dark fs-6 px-3 rounded-pill shadow-sm">
                        Cargo: <%= @obrero.cargo&.nombre_cargo || "Operativo" %>
                    </div>
                </div>
                <div class="col-6">
                    <div class="label-text">Primer Nombre</div>
                    <div class="data-text"><%= @obrero.name %></div>
                </div>
                <div class="col-6">
                    <div class="label-text">Segundo Nombre</div>
                    <div class="data-text"><%= @obrero.name2.presence || "-" %></div>
                </div>
                <div class="col-6">
                    <div class="label-text">Primer Apellido</div>
                    <div class="data-text"><%= @obrero.apellido %></div>
                </div>
                <div class="col-6">
                    <div class="label-text">Segundo Apellido</div>
                    <div class="data-text"><%= @obrero.apellido2.presence || "-" %></div>
                </div>
                <div class="col-6">
                    <div class="label-text">Cédula</div>
                    <div class="data-text"><%= @obrero.cedula %></div>
                </div>
                <div class="col-6">
                    <div class="label-text">Teléfono</div>
                    <div class="data-text"><%= @obrero.telefono %></div>
                </div>
                <div class="col-12">
                    <div class="label-text">Fecha de Nacimiento</div>
                    <div class="data-text"><%= @obrero.birthday.strftime("%d/%m/%Y") if @obrero.birthday %></div>
                </div>
                <div class="col-12">
                    <div class="label-text">Dirección Residencia</div>
                    <div class="data-text text-muted small" style="border:none;"><%= @obrero.direccion %></div>
                </div>
            </div>

            <div class="ficha-tecnica shadow-sm">
                <h6 class="fw-bold text-dark mb-3 text-center border-bottom pb-2">📋 FICHA TECNICA</h6>
                
                <div class="text-center mb-4">
                    <div class="label-text">ID Ministerio</div>
                    <div class="data-text font-monospace text-warning fs-5 mb-0" style="border:none;">
                        <%= @obrero.ministerio_id.presence || "❌ PENDIENTE" %>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <% if @obrero.antecedentes_penales.attached? %>
                        <label for="modal-ante-toggle" class="btn-visualizar">👁️ Ver Cert. de Antecedentes Penales</label>
                    <% else %>
                        <div class="alert alert-warning py-2 text-center small border-0">⚠️ Cert. de Antecedentes pendientes por cargar</div>
                    <% end %>
                </div>
            </div>

            <div class="row g-2 mt-4">
                <div class="col-6">
                    <%= link_to "Editar", edit_obrero_path(@obrero), class: "btn btn-success w-100 rounded-pill fw-bold" %>
                </div>
                <div class="col-6">
                    <%= link_to "Regresar", obreros_path, class: "btn btn-light border w-100 rounded-pill fw-bold" %>
                </div>
            </div>

            <div class="text-center mt-3">
                <%= button_to "Eliminar Registro", @obrero, method: :delete, data: { turbo_confirm: "¿Seguro?" }, class: "btn btn-link text-danger text-decoration-none small opacity-50" %>
            </div>
        </div>
    </div>
</div>

<div class="modal-overlay modal-ante-view">
    <label for="modal-ante-toggle" class="btn-cerrar-modal">×</label>
    <% if @obrero.antecedentes_penales.attached? %>
        <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center">
            <% if @obrero.antecedentes_penales.content_type == "application/pdf" %>
                <embed src="<%= url_for(@obrero.antecedentes_penales) %>" type="application/pdf" width="90%" height="80%" class="pdf-embed" />
            <% else %>
                <%= image_tag @obrero.antecedentes_penales, class: "img-fullscreen" %>
            <% end %>
            <div class="mt-3">
                <%= link_to "📥 Abrir original / Descargar", url_for(@obrero.antecedentes_penales),  class: "text-white text-decoration-none fw-bold", target: "_blank" %>
            </div>
        </div>
    <% end %>
</div>