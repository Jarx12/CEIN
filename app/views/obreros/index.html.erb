<div class="container mt-4">
  <%# Navigation Header %>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="fw-bold text-dark mb-0">
        Gestión de Obreros👷
        <span class="badge bg-teal-subtle text-teal rounded-pill fs-6 align-middle ms-2">
          <%= @obreros.count %> Personal
        </span>
      </h1>
      <p class="text-muted mb-0">Directorio del personal de mantenimiento y servicios generales</p>
    </div>

    <div class="d-flex gap-2">
      <%= link_to rrhh_path, class: "btn btn-outline-secondary rounded-pill px-4 d-flex align-items-center shadow-sm" do %>
        ↩️ <span class="ms-1">Regresar</span>
      <% end %>

      <%= link_to root_path, class: "btn btn-outline-secondary rounded-pill px-4 d-flex align-items-center shadow-sm" do %>
        🏠 <span class="ms-1">Ir al Inicio</span>
      <% end %>
    </div>
  </div>

  <%# Action Bar %>
  <div class="mb-4">
    <%= link_to new_obrero_path, class: "btn btn-primary btn-lg rounded-pill px-4 shadow d-inline-flex align-items-center gap-2" do %>
      ➕ <span>Registrar Nuevo Obrero</span>
    <% end %>
  </div>

  <%# Workers Table Card %>
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="bg-light border-bottom">
          <tr>
            <th class="ps-4 py-3 border-0 text-muted">Nombre y Apellido</th>
            <th class="py-3 border-0 text-muted">Cédula</th>
            <th class="py-3 border-0 text-muted">Cargo / Área</th>
            <th class="py-3 border-0 text-muted">Antigüedad</th> <%# New Column %>
            <th class="py-3 border-0 text-muted text-end pe-4">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% @obreros.each do |obrero| %>
            <tr>
              <td class="ps-4">
                <div class="d-flex align-items-center gap-3">
                  <div class="bg-teal-subtle text-teal rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; font-size: 0.8rem;">
                    <%= obrero.name[0] %><%= obrero.apellido[0] %>
                  </div>
                  <div>
                    <div class="fw-bold text-dark text-capitalize">
                      <%= obrero.name %> <%= obrero.apellido %>
                    </div>
                    <small class="text-muted">Servicios Generales</small>
                  </div>
                </div>
              </td>
              <td>
                <span class="text-muted">V-<%= obrero.cedula %></span>
              </td>
              <td>
                <% if obrero.cargo.present? %>
                  <span class="badge bg-orange-subtle text-orange border border-orange-subtle rounded-pill px-3 py-2">
                    <%= obrero.cargo.nombre_cargo %>
                  </span>
                <% else %>
                  <span class="text-muted fst-italic small">Sin asignar</span>
                <% end %>
              </td>
              
              <%# Service Time Column %>
              <td>
                <%# Change :fecha_ingreso to :created_at if you don't have a specific start date field %>
                <% start_date = obrero.respond_to?(:fecha_ingreso) ? obrero.fecha_ingreso : obrero.created_at %>
                <% if start_date %>
                  <div class="text-dark small fw-bold">
                    <%= distance_of_time_in_words(start_date, Time.now).capitalize %>
                  </div>
                  <div class="text-muted" style="font-size: 0.7rem;">
                    Ingreso: <%= start_date.strftime("%d/%m/%Y") %>
                  </div>
                <% else %>
                  <span class="text-muted small">---</span>
                <% end %>
              </td>

              <td class="text-end pe-4">
                <div class="btn-group shadow-sm rounded-pill overflow-hidden">
                  <%= link_to obrero, class: "btn btn-white btn-sm border-end px-3 py-2", title: "Ver ficha" do %>
                    👁️ Ver
                  <% end %>
                  <%= link_to edit_obrero_path(obrero), class: "btn btn-white btn-sm px-3 py-2", title: "Editar" do %>
                    ✏️ Editar
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>

          <% if @obreros.empty? %>
            <tr>
              <td colspan="5" class="text-center py-5 text-muted fst-italic">
                No hay personal obrero registrado actualmente.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<style>
  /* Your existing teal and orange styles remain here */
  .text-teal { color: #20c997 !important; }
  .bg-teal-subtle { background-color: #e6fcf5 !important; color: #087f5b !important; }
  .text-orange { color: #fd7e14 !important; }
  .bg-orange-subtle { background-color: #fff4e6 !important; color: #d9480f !important; }
  .btn-white { background: white; color: #555; border: 1px solid #dee2e6; }
  .btn-white:hover { background: #f8f9fa; color: #0d6efd; }
  .table tr { transition: background-color 0.2s ease; }
</style>