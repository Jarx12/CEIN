<div class="container-fluid px-4 py-4">
  <%# Encabezado Compacto %>
  <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
    <div>
      <h1 class="fw-bold text-dark mb-1 fs-3">Administración de Cartelera</h1>
      <p class="text-muted small mb-0">Gestione los anuncios, eventos y convocatorias oficiales expuestos a los representantes.</p>
    </div>
    <%= link_to zadmin_path, class: "btn btn-outline-secondary rounded-0 px-3 shadow-sm btn-sm fw-semibold" do %>
      ↩️ Regresar al Panel
    <% end %>
  </div>

  <div class="row g-4">
    <%# COLUMNA IZQUIERDA: Formulario optimizado en altura (col-lg-4) %>
    <div class="col-lg-4">
      <div class="card rounded-0 border shadow-sm bg-white sticky-lg-top" style="top: 20px; z-index: 10;">
        <div class="card-body p-4">
          <h5 class="fw-bold text-secondary mb-3 pb-2 border-bottom fs-6">📢 Nuevo Anuncio / Evento</h5>

          <%= form_with model: @event, local: true, data: { turbo: false }, class: "row g-3" do |f| %>
            
            <div class="col-12">
              <%= f.label :title, "Título del Aviso", class: "form-label small fw-bold text-muted mb-1" %>
              <%= f.text_field :title, class: "form-control rounded-0 form-control-sm fw-semibold", placeholder: "Ej: Asamblea de Fin de Año", required: true %>
            </div>

            <div class="col-12">
              <%= f.label :category, "Categoría", class: "form-label small fw-bold text-muted mb-1" %>
              <%= f.select :category, Event.categories.keys.map { |k| [k.humanize, k] }, {}, { class: "form-select rounded-0 form-select-sm fw-semibold" } %>
            </div>

            <div class="col-6">
              <%= f.label :event_date, "Fecha", class: "form-label small fw-bold text-muted mb-1" %>
              <%= f.date_field :event_date, class: "form-control rounded-0 form-control-sm small", required: true %>
            </div>

            <div class="col-6">
              <%= f.label :event_time, "Hora / Bloque", class: "form-label small fw-bold text-muted mb-1" %>
              <%= f.text_field :event_time, class: "form-control rounded-0 form-control-sm", placeholder: "Ej: 08:00 AM", required: true %>
            </div>

            <div class="col-12">
              <%= f.label :location, "Lugar / Ubicación", class: "form-label small fw-bold text-muted mb-1" %>
              <%= f.text_field :location, class: "form-control rounded-0 form-control-sm", placeholder: "Ej: Auditorio del CEIN", required: true %>
            </div>

            <div class="col-12">
              <%= f.label :description, "Descripción del Mensaje", class: "form-label small fw-bold text-muted mb-1" %>
              <%= f.text_area :description, class: "form-control rounded-0 small", rows: 3, placeholder: "Escriba los detalles obligatorios para el representante...", required: true %>
            </div>

            <div class="col-12 mt-4">
              <%= f.submit "🚀 Publicar en Cartelera", class: "btn btn-primary w-100 rounded-0 fw-bold shadow-sm py-2 btn-sm" %>
            </div>
          <% end %>

        </div>
      </div>
    </div>

    <%# COLUMNA DERECHA: Tabla informativa expandida (col-lg-8) %>
    <div class="col-lg-8">
      <div class="card rounded-0 border shadow-sm bg-white">
        <div class="card-body p-4">
          <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom fs-6">🗂️ Anuncios Actualmente Activos</h5>
          
          <% if @events.any? %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light rounded-0 border-bottom">
                  <tr>
                    <th style="width: 15%;">Fecha / Hora</th>
                    <th style="width: 55%;">Contenido de la Publicación</th>
                    <th style="width: 20%;">Ubicación</th>
                    <th class="text-center" style="width: 10%;">Acción</th>
                  </tr>
                </thead>
                <tbody>
                  <% @events.each do |event| %>
                    <tr class="border-bottom">
                      <%# Fecha y Hora %>
                      <td>
                        <div class="fw-bold text-dark"><%= event.event_date.strftime("%d/%m/%Y") %></div>
                        <div class="text-muted tracking-tight" style="font-size: 0.75rem;"><%= event.event_time %></div>
                      </td>
                      
                      <%# Título, Categoría y Descripción integrada %>
                      <td>
                        <div class="d-flex align-items-center gap-2 mb-1">
                          <span class="badge <%= event.category_badge_class %> rounded-0 px-2 py-1 fw-bold text-uppercase" style="font-size: 0.6rem; letter-spacing: 0.5px;">
                            <%= event.category_label %>
                          </span>
                          <span class="fw-bold text-dark text-truncate" style="max-width: 350px;"><%= event.title %></span>
                        </div>
                        <div class="text-muted small text-wrap border-start ps-2 mt-1" style="font-size: 0.8rem; line-height: 1.3;">
                          <%= event.description %>
                        </div>
                      </td>
                      
                      <%# Ubicación %>
                      <td class="text-secondary fw-semibold">
                        📍 <%= event.location.presence || "Plantel" %>
                      </td>
                      
                      <%# Botón de borrar %>
                      <td class="text-center">
                        <%= link_to event_path(event), data: { turbo_method: :delete, turbo_confirm: "¿Retirar este evento de la cartelera pública?" }, class: "btn btn-link text-danger p-1 text-decoration-none d-inline-flex align-items-center justify-content-center border rounded-0 bg-light bg-opacity-50", style: "width: 32px; height: 32px;", title: "Eliminar Aviso" do %>
                          ❌
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center text-muted py-5 bg-light bg-opacity-50 border">
              <span class="d-block mb-2" style="font-size: 2rem;">📌</span>
              <p class="mb-0 small italic fw-semibold">La cartelera pública está vacía.</p>
              <p class="mb-0 text-muted extra-small">Use el panel izquierdo para redactar la primera notificación de la institución.</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>