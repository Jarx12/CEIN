<div class="container mt-4">
  <%# Navigation Header %>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="fw-bold text-dark mb-0">
        Periodos Académicos🗓️ 
      </h1>
      <p class="text-muted mb-0">Gestión del ciclo de vida del año escolar y estatus operativo</p>
    </div>

    <div class="d-flex gap-2">
      <%= link_to zadmin_path, class: "btn btn-outline-secondary rounded-pill px-4 d-flex align-items-center shadow-sm" do %>
        ↩️ <span class="ms-1">Regresar</span>
      <% end %>

      <%= link_to root_path, class: "btn btn-outline-secondary rounded-pill px-4 d-flex align-items-center shadow-sm" do %>
        🏠 <span class="ms-1">Ir al Inicio</span>
      <% end %>
    </div>
  </div>

  <%# Action Bar %>
  <div class="mb-4">
    <%= link_to new_academic_period_path, class: "btn btn-indigo btn-lg rounded-pill px-4 shadow d-inline-flex align-items-center gap-2" do %>
      ➕ <span>Crear Nuevo Periodo</span>
    <% end %>
  </div>

  <%# Period Management Table Card %>
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="bg-light border-bottom">
          <tr>
            <th class="ps-4 py-3 border-0 text-muted">Nombre del Periodo</th>
            <th class="py-3 border-0 text-muted">Rango de Fechas</th>
            <th class="py-3 border-0 text-muted text-center">Estado Actual</th>
            <th class="py-3 border-0 text-muted text-end pe-4">Controles de Ciclo</th>
          </tr>
        </thead>
        <tbody>
  <% @academic_periods.each do |period| %>
    <tr class="<%= 'bg-indigo-light' if period.active? %>">
      <td class="ps-4">
        <div class="fw-bold text-dark fs-5"><%= period.name %></div>
        <% if period.active? %>
          <small class="text-indigo fw-bold text-uppercase" style="font-size: 0.7rem;">
            🌟 Periodo en curso
          </small>
        <% end %>
      </td>
      <td>
        <div class="small text-muted">
          <span class="fw-semibold text-dark"><%= period.start_date&.strftime("%b %Y") %></span> 
          → 
          <span class="fw-semibold text-dark"><%= period.end_date&.strftime("%b %Y") %></span>
        </div>
      </td>
      <td class="text-center">
        <% 
          badge_class = case period.status
            when 'active' then 'bg-success text-white'
            when 'closed' then 'bg-danger text-white'
            else 'bg-secondary text-white'
          end 
        %>
        <span class="badge rounded-pill px-3 py-2 <%= badge_class %> shadow-sm">
          <%= period.status.capitalize %>
        </span>
      </td>
      <td class="text-end pe-4">
        <div class="d-flex justify-content-end gap-2">
          <%# 1. State Actions (Start/Finish) %>
          <% if period.inactive? || period.closed? %>
            <%= button_to activate_academic_period_path(period), 
                          method: :patch, 
                          class: "btn btn-outline-success btn-sm rounded-pill px-3 fw-bold" do %>
              ▶️ Iniciar
            <% end %>
          <% elsif period.active? %>
            <%= button_to close_academic_period_path(period), 
                          method: :patch, 
                          class: "btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold",
                          data: { turbo_confirm: "¿Estás completamente seguro de finalizar el año escolar?" } do %>
              ⏹️ Finalizar
            <% end %>
          <% end %>
          
          <%# 2. Show Link (New) %>
          <%= link_to academic_period_path(period), class: "btn btn-light btn-sm rounded-circle p-2 border", title: "Ver Detalles" do %>
            👁️
          <% end %>

          <%# 3. Edit Link %>
          <%= link_to edit_academic_period_path(period), class: "btn btn-light btn-sm rounded-circle p-2 border", title: "Configurar" do %>
            ⚙️
          <% end %>
        </div>
      </td>
    </tr>
  <% end %>

          <% if @academic_periods.empty? %>
            <tr>
              <td colspan="4" class="text-center py-5 text-muted fst-italic">
                No se han definido periodos académicos todavía.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<style>
  .btn-indigo { background-color: #4e73df; color: white; border: none; }
  .btn-indigo:hover { background-color: #2e59d9; color: white; }
  .text-indigo { color: #4e73df; }
  .bg-indigo-light { background-color: rgba(78, 115, 223, 0.03); }
  
  .table-hover tbody tr:hover {
    background-color: rgba(0,0,0,.02);
  }
  
  .badge { letter-spacing: 0.5px; font-weight: 600; }
</style>