<div class="container mt-4">
  <%# Navigation Header %>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="fw-bold text-dark mb-0">
         Gestión de Docentes👩‍🏫
        <span class="badge bg-indigo-subtle text-indigo rounded-pill fs-6 align-middle ms-2">
          <%= @docentes.count %> Profesores
        </span>
      </h1>
      <p class="text-muted mb-0">Listado del personal académico y facilitadores del CEIN</p>
    </div>

    <div class="d-flex gap-2">
      <%= link_to rrhh_path, class: "btn btn-outline-secondary rounded-pill px-4 d-flex align-items-center shadow-sm" do %>
        ↩️ <span class="ms-1">Regresar</span>
      <% end %>

      <%= link_to root_path, class: "btn btn-outline-secondary rounded-pill px-4 d-flex align-items-center shadow-sm" do %>
        🏠 <span class="ms-1">Ir al Inicio</span>
      <% end %>
    </div>
  </div>

  <%# Action Bar %>
  <div class="mb-4">
    <%= link_to new_docente_path, class: "btn btn-primary btn-lg rounded-pill px-4 shadow d-inline-flex align-items-center gap-2" do %>
      ➕ <span>Registrar Nuevo Docente</span>
    <% end %>
  </div>

  <%# Teachers Table Card %>
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="bg-light border-bottom">
          <tr>
            <th class="ps-4 py-3 border-0 text-muted">Nombre y Apellido</th>
            <th class="py-3 border-0 text-muted text-center">Estatus</th>
            <th class="py-3 border-0 text-muted text-center">Antigüedad</th> <%# Added column %>
            <th class="py-3 border-0 text-muted text-end pe-4">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% @docentes.each do |docente| %>
            <tr>
              <td class="ps-4">
                <div class="d-flex align-items-center gap-3">
                  <div class="bg-indigo-subtle text-indigo rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; font-size: 0.8rem;">
                    <%= docente.name[0] %><%= docente.apellido[0] %>
                  </div>
                  <div>
                    <div class="fw-bold text-dark text-capitalize">
                      <%= docente.name %> <%= docente.apellido %>
                    </div>
                    <small class="text-muted">Personal Docente</small>
                  </div>
                </div>
              </td>
              <td class="text-center">
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                  Activo
                </span>
              </td>

              <%# Service Time Logic %>
              <td class="text-center">
                <% start_date = docente.respond_to?(:fecha_ingreso) ? docente.fecha_ingreso : docente.created_at %>
                <% if start_date %>
                  <div class="text-dark small fw-bold">
                    <%= distance_of_time_in_words(start_date, Time.now).capitalize %>
                  </div>
                  <div class="text-muted" style="font-size: 0.7rem;">
                    Desde: <%= start_date.strftime("%d/%m/%Y") %>
                  </div>
                <% else %>
                  <span class="text-muted small">---</span>
                <% end %>
              </td>

              <td class="text-end pe-4">
                <div class="btn-group shadow-sm rounded-pill overflow-hidden">
                  <%= link_to docente, class: "btn btn-white btn-sm border-end px-3 py-2", title: "Ver expediente" do %>
                    👁️ Ver
                  <% end %>
                  <%= link_to edit_docente_path(docente), class: "btn btn-white btn-sm px-3 py-2", title: "Editar" do %>
                    ✏️ Editar
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>

          <% if @docentes.empty? %>
            <tr>
              <td colspan="4" class="text-center py-5 text-muted fst-italic">
                No hay docentes registrados en el sistema académico.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<style>
  .text-indigo { color: #6610f2 !important; }
  .bg-indigo-subtle { background-color: #f1ecff !important; color: #6610f2 !important; }
  .bg-success-subtle { background-color: #d1e7dd; color: #0f5132 !important; }
  .btn-white { background: white; color: #555; border: 1px solid #dee2e6; }
  .btn-white:hover { background: #f8f9fa; color: #0d6efd; }
  .table tr { transition: background-color 0.2s ease; }
</style>