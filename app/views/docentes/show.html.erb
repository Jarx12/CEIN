<style>
    /* --- Estilos de la Tarjeta y Contenedores --- */
    body { background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    .card-profile { border-radius: 1.5rem; max-width: 520px; margin: 40px auto; background: white; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.15); border: none; position: relative; }
    .profile-header { background: linear-gradient(135deg, #6610f2, #007bff); padding: 2.5rem; color: white; text-align: center; }
    
    /* --- Estilos de Etiquetas y Datos --- */
    .label-text { font-size: 0.7rem; text-transform: uppercase; color: #6c757d; font-weight: 800; margin-bottom: 2px; letter-spacing: 0.5px; }
    .data-text { color: #212529; font-weight: 500; margin-bottom: 1.2rem; font-size: 1rem; border-bottom: 1px solid #f8f9fa; padding-bottom: 4px; }
    .ficha-tecnica { background-color: #f8f9fa; border-radius: 1rem; padding: 1.5rem; border: 1px solid #eee; margin-top: 10px; }

    /* --- VISUALIZADORES SIN JAVASCRIPT (CHECKBOX HACK) --- */
    #modal-titulo-toggle, #modal-ante-toggle { display: none; } /* Escondemos los controles */

    .modal-overlay {
        display: none; 
        position: fixed;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.92);
        z-index: 99999;
        justify-content: center; align-items: center;
        padding: 20px;
        backdrop-filter: blur(8px);
        flex-direction: column;
    }

    /* Lógica de activación por Checkbox */
    #modal-titulo-toggle:checked ~ .modal-titulo-view { display: flex; }
    #modal-ante-toggle:checked ~ .modal-ante-view { display: flex; }

    /* Botones de Visualización */
    .btn-visualizar {
        display: inline-block; width: 100%; background: #6610f2; color: white !important;
        text-align: center; padding: 12px; border-radius: 10px; text-decoration: none;
        font-weight: bold; cursor: pointer; border: none; margin-bottom: 10px; transition: 0.3s;
    }
    .btn-visualizar:hover { background: #520dc2; transform: translateY(-2px); }
    .btn-ante { background: #495057; }
    .btn-ante:hover { background: #343a40; }

    /* Elementos del Modal */
    .img-fullscreen { max-width: 95%; max-height: 85vh; border: 4px solid white; border-radius: 8px; box-shadow: 0 0 25px rgba(0,0,0,0.5); }
    .pdf-embed { border: 5px solid white; border-radius: 8px; box-shadow: 0 0 25px rgba(0,0,0,0.5); background: white; }
    .btn-cerrar-modal { position: absolute; top: 25px; right: 25px; color: white; font-size: 35px; cursor: pointer; text-decoration: none; font-weight: bold; width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.1); border-radius: 50%; }
    .btn-cerrar-modal:hover { background: rgba(255,255,255,0.3); }
</style>


<input type="checkbox" id="modal-titulo-toggle">
<input type="checkbox" id="modal-ante-toggle">

<div class="container pb-5">
    <div class="card card-profile">
        <div class="profile-header text-center">
            <div class="bg-white text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 80px; height: 80px; font-size: 2.5rem;">
                👩‍🏫
            </div>
            <h2 class="fw-bold mb-0"><%= @docente.name %> <%= @docente.apellido %></h2>
            <p class="mb-0 opacity-75 fw-light">Personal Docente Académico</p>
        </div>

        <div class="card-body p-4">
            <div class="row text-start">
                <div class="col-6">
                    <div class="label-text">Primer Nombre</div>
                    <div class="data-text"><%= @docente.name %></div>
                </div>
                <div class="col-6">
                    <div class="label-text">Segundo Nombre</div>
                    <div class="data-text"><%= @docente.name2.presence || "-" %></div>
                </div>
                <div class="col-6">
                    <div class="label-text">Primer Apellido</div>
                    <div class="data-text"><%= @docente.apellido %></div>
                </div>
                <div class="col-6">
                    <div class="label-text">Segundo Apellido</div>
                    <div class="data-text"><%= @docente.apellido2.presence || "-" %></div>
                </div>
                <div class="col-6">
                    <div class="label-text">Cédula de Identidad</div>
                    <div class="data-text"><%= @docente.cedula %></div>
                </div>
                <div class="col-6">
                    <div class="label-text">Teléfono Móvil</div>
                    <div class="data-text"><%= @docente.telefono %></div>
                </div>
                <div class="col-12 text-center bg-light py-2 rounded-3 mb-3">
                    <div class="label-text">Fecha de Nacimiento</div>
                    <div class="data-text mb-0"><%= @docente.birthday.strftime("%d de %B de %Y") if @docente.birthday %></div>
                </div>
                <div class="col-12">
                    <div class="label-text">Dirección de Domicilio</div>
                    <div class="data-text text-muted small" style="border:none;"><%= @docente.direccion %></div>
                </div>
            </div>

            <div class="ficha-tecnica shadow-sm">
                <h6 class="fw-bold text-primary mb-3 text-center border-bottom pb-2">📋 FICHA TÉCNICA</h6>
                
                <div class="text-center mb-4">
                    <div class="label-text">ID Nacional del Ministerio</div>
                    <div class="data-text font-monospace text-primary fs-5 mb-0" style="border:none;">
                        <%= @docente.ministerio_id.presence || "❌ PENDIENTE DE REGISTRO" %>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <%# Sección Título %>
                    <% if @docente.foto_titulo.attached? %>
                        <label for="modal-titulo-toggle" class="btn-visualizar">
                            👁️ Ver Título Profesional
                        </label>
                    <% else %>
                        <div class="alert alert-warning py-2 text-center small mb-2 border-0">⚠️ Título pendiente por cargar</div>
                    <% end %>

                    <%# Sección Antecedentes %>
                    <% if @docente.antecedentes_penales.attached? %>
                        <label for="modal-ante-toggle" class="btn-visualizar btn-ante">
                            👁️ Ver Cert. de Antecedentes Penales</label>
                        </label>
                    <% else %>
                        <div class="alert alert-warning py-2 text-center small border-0">⚠️ Cert. de Antecedentes pendientes por cargar</div>
                    <% end %>
                </div>
            </div>

            <div class="row g-2 mt-4">
                <div class="col-6">
                    <%= link_to "Editar Perfil", edit_docente_path(@docente), class: "btn btn-success w-100 rounded-pill fw-bold py-2 shadow-sm" %>
                </div>
                <div class="col-6">
                    <%= link_to "Regresar", docentes_path, class: "btn btn-light border w-100 rounded-pill fw-bold py-2 shadow-sm" %>
                </div>
            </div>

            <div class="text-center mt-4">
                <%= button_to "Eliminar Docente del Sistema", @docente, method: :delete, data: { turbo_confirm: "¿Está totalmente seguro de eliminar este registro?" }, class: "btn btn-link text-danger text-decoration-none small opacity-50" %>
            </div>
        </div>
    </div>
</div>

<div class="modal-overlay modal-titulo-view">
    <label for="modal-titulo-toggle" class="btn-cerrar-modal">×</label>
    <% if @docente.foto_titulo.attached? %>
        <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center">
            <% if @docente.foto_titulo.content_type == "application/pdf" %>
                <embed src="<%= url_for(@docente.foto_titulo) %>" type="application/pdf" width="90%" height="80%" class="pdf-embed" />
            <% else %>
                <%= image_tag @docente.foto_titulo, class: "img-fullscreen" %>
            <% end %>
            <div class="mt-3">
                <%= link_to "📥 Abrir original / Descargar", url_for(@docente.foto_titulo), class: "text-white text-decoration-none fw-bold", target: "_blank" %>
            </div>
        </div>
    <% end %>
</div>

<div class="modal-overlay modal-ante-view">
    <label for="modal-ante-toggle" class="btn-cerrar-modal">×</label>
    <% if @docente.antecedentes_penales.attached? %>
        <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center">
            <% if @docente.antecedentes_penales.content_type == "application/pdf" %>
                <embed src="<%= url_for(@docente.antecedentes_penales) %>" type="application/pdf" width="90%" height="80%" class="pdf-embed" />
            <% else %>
                <%= image_tag @docente.antecedentes_penales, class: "img-fullscreen" %>
            <% end %>
            <div class="mt-3">
                <%= link_to "📥 Abrir original / Descargar", url_for(@docente.antecedentes_penales), class: "text-white text-decoration-none fw-bold", target: "_blank" %>
            </div>
        </div>
    <% end %>
</div>