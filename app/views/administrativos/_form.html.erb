<style>
    .form-container {
        max-width: 650px;
        margin: 40px auto;
    }
    .card-admin {
        border-radius: 1.25rem;
        border: none;
    }
    .form-label {
        font-size: 0.9rem;
        margin-bottom: 0.4rem;
    }
    .form-control, .form-select {
        border-radius: 0.75rem;
        padding: 0.65rem 1rem;
        border: 1px solid #ced4da;
    }
    .form-control:focus, .form-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1);
    }
    .error-box {
        background-color: #fff5f5;
        border-left: 4px solid #e53e3e;
        border-radius: 0.75rem;
    }
</style>

<div class="container form-container">
    <%# Error Feedback Section %>
    <% if @administrativo.errors.any? %>
      <div class="error-box p-4 mb-4 shadow-sm">
        <h5 class="text-danger fw-bold">⚠️ Verifique los siguientes datos:</h5>
        <ul class="mb-0 small text-danger">
          <% @administrativo.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="card card-admin shadow-lg p-4 p-md-5">
        <div class="text-center mb-4">
            <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                <span style="font-size: 1.8rem;">💼</span>
            </div>
            <h2 class="fw-bold text-dark mb-1"><%= tipo %></h2>
            <p class="text-muted">Registro de Personal Administrativo</p>
        </div>

        <%= form_with model: administrativo, local: true do |form| %>
            <div class="row g-3">
                <%# Row 1: Names %>
                <div class="col-md-6">
                    <%= form.label :name, "Primer Nombre", class: "form-label fw-bold text-secondary" %>
                    <%= form.text_field :name, class: 'form-control', placeholder: 'Ej. Ivan', required: true %>
                </div>
                <div class="col-md-6">
                    <%= form.label :name2, "Segundo Nombre", class: "form-label fw-bold text-secondary" %>
                    <%= form.text_field :name2, class: 'form-control', placeholder: 'Ej. Giuseppe' %>
                </div>

                <%# Row 2: Last Names %>
                <div class="col-md-6">
                    <%= form.label :apellido, "Primer Apellido", class: "form-label fw-bold text-secondary" %>
                    <%= form.text_field :apellido, class: 'form-control', placeholder: 'Ej. Expedito', required: true %>
                </div>
                <div class="col-md-6">
                    <%= form.label :apellido2, "Segundo Apellido", class: "form-label fw-bold text-secondary" %>
                    <%= form.text_field :apellido2, class: 'form-control', placeholder: 'Ej. Campos' %>
                </div>

                <%# Row 3: ID and Phone %>
                <div class="col-md-6">
                    <%= form.label :cedula, "Cédula de Identidad", class: "form-label fw-bold text-secondary" %>
                    <%= form.text_field :cedula, class: 'form-control', placeholder: '12345678', required: true %>
                </div>
                <div class="col-md-6">
                    <%= form.label :telefono, "Teléfono de Oficina/Personal", class: "form-label fw-bold text-secondary" %>
                    <%= form.text_field :telefono, class: 'form-control', placeholder: '04261234567', required: true %>
                </div>

                <%# Row 4: Birthday and Cargo %>
                <div class="col-md-6">
                    <%= form.label :birthday, "Fecha de Nacimiento", class: "form-label fw-bold text-secondary" %>
                    <%= form.date_field :birthday, class: 'form-control', required: true %>
                </div>
                <div class="col-md-6">
                    <%= form.label :cargo_id, "Cargo Administrativo", class: "form-label fw-bold text-secondary" %>
                    <%= form.collection_select :cargo_id, Cargo.all, :id, :nombre_cargo, 
                        { prompt: "Seleccione un cargo..." }, 
                        { class: "form-select", required: true } %>
                </div>

                <%# Row 5: Address %>
                <div class="col-12">
                    <%= form.label :direccion, "Dirección de Domicilio", class: "form-label fw-bold text-secondary" %>
                    <%= form.text_area :direccion, rows: 2, class: 'form-control', placeholder: 'Av. Gral Rivera, Edif...', required: true %>
                </div>
                <%# --- SECCIÓN: FICHA TÉCNICA --- %>
                <div class="col-12 mt-4">
                    <hr class="text-muted opacity-25">
                    <h5 class="fw-bold text-indigo mb-3">📋 Ficha Técnica</h5>
                </div>

                <%# ID Ministerio %>
                <div class="col-12">
                    <%= form.label :ministerio_id, "ID Nacional del Ministerio", class: "form-label fw-bold text-secondary" %>
                    <%= form.text_field :ministerio_id, class: 'form-control', placeholder: 'Ej. MPPE-12345678' %>
                </div>

                <%# Título (Docentes y Administrativos) %>
                <div class="col-md-6">
                    <%= form.label :foto_titulo, "Imagen del Título Profesional", class: "form-label fw-bold text-secondary" %>
                    <%= form.file_field :foto_titulo, class: 'form-control', accept: 'image/*,application/pdf' %>
                    <div class="form-text small">Subir imagen o PDF legible del título.</div>
                </div>

                <%# Antecedentes Penales %>
                <div class="col-md-6">
                    <%= form.label :antecedentes_penales, "Antecedentes Penales", class: "form-label fw-bold text-secondary" %>
                    <%= form.file_field :antecedentes_penales, class: 'form-control', accept: 'image/*,application/pdf' %>
                    <div class="form-text small">Cargar comprobante (Imagen o PDF).</div>
                </div>
                <%# ------------------------------ %>
                <%# Action Buttons %>
                <div class="col-12 mt-4 text-center">
                    <%= form.submit "Guardar Personal", class: "btn btn-primary btn-lg w-100 rounded-pill shadow-sm fw-bold mb-2 py-3" %>
                    <%= link_to "Cancelar y Volver", administrativos_path, class: "btn btn-link text-muted text-decoration-none" %>
                </div>
            </div>
        <% end %>
    </div>
</div>