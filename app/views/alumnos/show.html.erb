<style>
    .profile-container { max-width: 600px; margin: 40px auto; }
    .profile-card { border-radius: 1.5rem; border: none; background: #fff; overflow: hidden; }
    .profile-header { background: linear-gradient(135deg, #6366f1, #a855f7); padding: 3rem 2rem; color: white; }
    .profile-avatar { width: 100px; height: 100px; background: white; color: #6366f1; border-radius: 2rem; display: flex; align-items: center; justify-content: center; font-size: 3rem; margin: 0 auto 1rem; box-shadow: 0 10px 15px rgba(0,0,0,0.1); }
    .info-group { padding: 1.5rem; border-bottom: 1px solid #f0f2f5; }
    .info-group:last-child { border-bottom: none; }
    
    .label-caps { font-size: 0.7rem; font-weight: 800; text-transform: uppercase; color: #94a3b8; letter-spacing: 1px; margin-bottom: 0.5rem; display: block; }
    .value-text { font-size: 1.1rem; color: #1e293b; font-weight: 600; }
    .rep-badge { background: #f1f5f9; border-radius: 1rem; padding: 1rem; margin-top: 0.5rem; }

    /* --- VISUALIZADORES SIN JAVASCRIPT (CORREGIDO) --- */
    #modal-acta-toggle { display: none; } 

    .modal-overlay {
        display: none; 
        position: fixed;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.92);
        z-index: 99999;
        justify-content: center; align-items: center;
        padding: 20px;
        backdrop-filter: blur(8px);
        flex-direction: column;
    }

    /* Lógica de activación */
    #modal-acta-toggle:checked ~ .modal-acta-view { display: flex; }

    .btn-visualizar {
        display: inline-block; width: 100%; background: #6366f1; color: white !important;
        text-align: center; padding: 12px; border-radius: 10px; text-decoration: none;
        font-weight: bold; cursor: pointer; border: none; transition: 0.3s;
    }
    .btn-visualizar:hover { background: #4f46e5; transform: translateY(-2px); }

    .img-fullscreen { max-width: 95%; max-height: 85vh; border: 4px solid white; border-radius: 8px; }
    .pdf-embed { border: 5px solid white; border-radius: 8px; background: white; }
    .btn-cerrar-modal { position: absolute; top: 25px; right: 25px; color: white; font-size: 35px; cursor: pointer; text-decoration: none; font-weight: bold; width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.1); border-radius: 50%; }
</style>

<%# 1. El Input debe estar al mismo nivel que el modal %>
<input type="checkbox" id="modal-acta-toggle">

<div class="container profile-container">
    <div class="profile-card shadow-lg">
        <div class="profile-header text-center">
            <div class="profile-avatar">🎓</div>
            <h2 class="fw-bold mb-1">
                <%= @alumno.name %> <%= @alumno.apellido %>
            </h2>
            <div class="badge rounded-pill bg-white bg-opacity-25 px-3 py-2 mt-2">
            Nivel Anterior: <%= @alumno.grado_anterior || "Sin Registro Anterior" %>
            </div>
        </div>
        

        <div class="card-body p-0">
            <div class="row g-0">
                <div class="col-6 info-group border-end">
                    <span class="label-caps">Nombres</span>
                    <div class="value-text"><%= "#{@alumno.name} #{@alumno.name2}".strip %></div>
                </div>
                <div class="col-6 info-group">
                    <span class="label-caps">Apellidos</span>
                    <div class="value-text"><%= "#{@alumno.apellido} #{@alumno.apellido2}".strip %></div>
                </div>
            </div>
        <div class="card-body p-0">
            <div class="row g-0">
                <div class="col-6 info-group border-end">
                    <span class="label-caps">Sección Actual</span>
                    <div class="value-text"><%= "#{@alumno.seccion_actual&.nombre_seccion || 'Sin Inscripción Activa'}" %></div>
                </div>
                <div class="col-6 info-group">
                    <span class="label-caps">Nivel Actual</span>
                    <div class="value-text"><%= "#{@alumno&.grado_actual || 'Sin Inscripción Activa'}" %></div>
                </div>
            </div>
            <div class="info-group">
                <span class="label-caps">Fecha de Nacimiento</span>
                <div class="value-text">
                    <%= @alumno.birthday&.strftime("%d de %B, %Y") || "No registrada" %>
                    <% if @alumno.birthday %>
                        <span class="badge bg-primary-subtle text-primary ms-2">
                            <%= ((Time.zone.now - @alumno.birthday.to_time) / 1.year.seconds).floor %> años
                        </span>
                    <% end %>
                </div>
            </div>
            </div>

            <div class="info-group">
                <span class="label-caps">Representante Legal</span>
                <div class="rep-badge mb-2 d-flex align-items-center">
                    <div class="me-3 fs-3">👨‍👩‍👧</div>
                    <div>
                        <div class="fw-bold text-dark"><%= @alumno.representante&.full_name || "No asignado" %></div>
                        <div class="small text-muted">Principal • C.I: <%= @alumno.representante&.cedula %></div>
                    </div>
                </div>
            </div>

            <div class="p-4 bg-white d-grid gap-2">
                <%# 2. Botón de Visualización %>
                <% if @alumno.acta_nacimiento.attached? %>
                    <label for="modal-acta-toggle" class="btn-visualizar mb-3">
                        👁️ Ver Partida de Nacimiento
                    </label>
                <% else %>
                    <div class="alert alert-warning py-2 text-center small mb-3 border-0">
                        ⚠️ Partida de nacimiento pendiente por cargar
                    </div>
                <% end %>

                <div class="row g-2">
                    <div class="col-6">
                        <%= link_to "Regresar", alumnos_path, class: "btn btn-outline-secondary w-100 rounded-pill fw-bold" %>
                    </div>
                    <div class="col-6">
                        <%= link_to "Editar", edit_alumno_path(@alumno), class: "btn text-white w-100 rounded-pill fw-bold", style: "background-color: #6366f1;" %>
                    </div>
                </div>
                <%= button_to "Eliminar Registro", @alumno, method: :delete, data: { turbo_confirm: "¿Está seguro?" }, class: "btn btn-link text-danger text-decoration-none small mt-2" %>
            </div>
        </div>
    </div>
</div>

<%# 3. Modal Corregido (Clase modal-acta-view debe coincidir con el CSS) %>
<div class="modal-overlay modal-acta-view">
    <label for="modal-acta-toggle" class="btn-cerrar-modal">×</label>
    <% if @alumno.acta_nacimiento.attached? %>
        <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center">
            <% if @alumno.acta_nacimiento.content_type == "application/pdf" %>
                <embed src="<%= url_for(@alumno.acta_nacimiento) %>" type="application/pdf" width="90%" height="80%" class="pdf-embed" />
            <% else %>
                <%= image_tag @alumno.acta_nacimiento, class: "img-fullscreen" %>
            <% end %>
            <div class="mt-3">
                <%= link_to "📥 Abrir original / Descargar", url_for(@alumno.acta_nacimiento), class: "text-white text-decoration-none fw-bold", target: "_blank" %>
            </div>
        </div>
    <% end %>
</div>