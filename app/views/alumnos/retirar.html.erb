<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="fw-bold text-dark mb-0">Procesar Retiro de Alumno 🎒</h1>
      <p class="text-muted mb-0">Registro formal de desincorporación de la matrícula activa</p>
    </div>
    <%= link_to alumnos_path, class: "btn btn-outline-secondary rounded-pill px-4 shadow-sm" do %>
      ↩️ Cancelar
    <% end %>
  </div>

  <div class="row">
    <div class="col-md-6 mx-auto">
      <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-body p-4 bg-light-subtle">
          <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Datos del Alumno</h5>
          <p class="mb-1"><strong>Nombres y Apellidos:</strong> <span class="text-capitalize"><%= @alumno.nombre_completo %></span></p>
          <p class="mb-1"><strong>Edad:</strong> <%= @alumno.age %> años</p>
          <p class="mb-1"><strong>Nivel Actual:</strong> <%= @enrollment_actual.seccion.nivel.nombre_nivel %> — Sección: "<%= @enrollment_actual.seccion.nombre_seccion %>"</p>
          <p class="mb-0"><strong>Representante:</strong> <%= @alumno.representante.full_name rescue 'No registrado' %> (C.I: <%= @alumno.representante_id %>)</p>
        </div>
      </div>

      <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-danger-subtle py-3 border-0">
          <h5 class="mb-0 fw-bold text-danger-emphasis">Seleccione el Motivo de la Solicitud</h5>
        </div>
        
        <div class="card-body p-4">
          <%= form_with url: procesar_retiro_alumno_path(@alumno), method: :patch do |form| %>
            
            <div class="form-check p-3 border rounded-3 mb-3 hover-shadow transition-all">
              <%= form.radio_button :withdrawal_reason, :traslado_voluntario, checked: true, class: "form-check-input ms-0 me-2" %>
              <%= form.label :withdrawal_reason_traslado_voluntario, class: "form-check-label fw-bold text-dark d-block cursor-pointer" do %>
                🔀 Traslado Voluntario
                <span class="d-block text-muted small fw-normal mt-1">El representante solicita retirar al niño por cambio de residencia, preferencia personal u otros motivos justificados.</span>
              <% end %>
            </div>

            <div class="form-check p-3 border rounded-3 mb-4 hover-shadow transition-all">
              <%= form.radio_button :withdrawal_reason, :egreso_maximo_nivel, class: "form-check-input ms-0 me-2" %>
              <%= form.label :withdrawal_reason_egreso_maximo_nivel, class: "form-check-label fw-bold text-dark d-block cursor-pointer" do %>
                🎓 Egreso por Límite de Nivel Educativo
                <span class="d-block text-muted small fw-normal mt-1">El alumno culminó con éxito el nivel de Tercer Grupo de Preescolar y debe ser trasladado a una Escuela Primaria.</span>
              <% end %>
            </div>

            <div class="d-grid">
              <%= form.submit "Confirmar y Retirar Matrícula", 
                              class: "btn btn-danger btn-lg rounded-pill fw-bold fs-6 shadow-sm", 
                              data: { confirm: "¿Está seguro de aplicar este retiro? El alumno dejará de aparecer en las listas de asistencia." } %>
            </div>

          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .bg-danger-subtle { background-color: #ffeeef !important; color: #a9212a !important; }
  .hover-shadow:hover { background-color: #f8f9fa; border-color: #dee2e6 !important; }
  .cursor-pointer { cursor: pointer; }
  .transition-all { transition: all 0.2s ease-in-out; }
</style>