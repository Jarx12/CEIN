<div class="row justify-content-center" style="margin-top: 80px;">
  <div class="col-md-5 col-lg-4">
    
    <%# Tarjeta de Login %>
    <div class="card border-0 shadow-lg rounded-4">
      <div class="card-body p-5">
        
        <%# Encabezado con el logo que usas en el Nav %>
        <div class="text-center mb-4">
          <h2 class="fw-bold text-primary">📚 SICEIN</h2>
          <p class="text-muted">Gestión de Control de Estudios</p>
        </div>

        <hr class="my-4 text-secondary opacity-25">

        <%= form_with url: session_path, class: "needs-validation" do |form| %>
          
          <%# Campo Email %>
          <div class="mb-3">
            <label class="form-label fw-semibold text-secondary small">Correo Electrónico</label>
            <%= form.email_field :email_address, 
                required: true, 
                autofocus: true, 
                autocomplete: "username", 
                placeholder: "nombre@ejemplo.com", 
                value: params[:email_address],
                class: "form-control form-control-lg border-2 bg-light rounded-3" %>
          </div>

          <%# Campo Contraseña %>
          <div class="mb-4">
            <div class="d-flex justify-content-between">
              <label class="form-label fw-semibold text-secondary small">Contraseña</label>
              <%= link_to "¿Olvidó su clave?", new_password_path, class: "small text-decoration-none" %>
            </div>
            <%= form.password_field :password, 
                required: true, 
                autocomplete: "current-password", 
                placeholder: "••••••••", 
                maxlength: 72,
                class: "form-control form-control-lg border-2 bg-light rounded-3" %>
          </div>

          <%# Botón de Envío %>
          <div class="d-grid shadow-sm">
            <%= form.submit "Iniciar Sesión", class: "btn btn-primary btn-lg fw-bold rounded-3 py-3" %>
          </div>

        <% end %>

      </div>
    </div>

    <%# Pie de página opcional %>
    <p class="text-center mt-4 text-muted small">
      &copy; <%= Time.current.year %> SICEIN
    </p>

  </div>
</div>