<div class="container mt-5">
  <%# Hero Section: Panel de Dirección General %>
  <div class="p-5 mb-5 bg-dark text-white rounded-5 shadow position-relative overflow-hidden" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
    <div class="row align-items-center">
      <div class="col-md-8 position-relative" style="z-index: 2;">
        <span class="badge bg-primary text-uppercase px-3 py-2 rounded-pill mb-3" style="letter-spacing: 1.5px; font-size: 0.75rem;">Dirección General</span>
        <h1 class="display-5 fw-bold mb-2">Bienvenido, Dirección</h1>
        <p class="lead opacity-75 mb-4">Panel de supervisión del Sistema Integrado de Control del Centro de Educación Inicial (SICEIN). Controle la matrícula, personal y configuraciones base del sistema.</p>
        
        <div class="d-flex flex-wrap gap-2">
          <%= link_to root_path, class: "btn btn-outline-light px-4 rounded-pill d-flex align-items-center gap-2" do %>
            🏠 <span>Ir al inicio</span>
          <% end %>
        </div>
      </div>
      <div class="col-md-4 text-center d-none d-md-block">
         <span style="font-size: 8rem; opacity: 0.15;" class="user-select-none">🏢</span>
      </div>
    </div>
  </div>

  <%# Sección Informativa %>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h3 class="fw-bold text-dark mb-1">Módulos Estratégicos</h3>
      <p class="text-muted small mb-0">Gestión de datos institucionales del Periodo Académico Activo.</p>
    </div>
    <span class="badge bg-secondary-subtle text-secondary px-3 py-2 rounded-pill fw-semibold">
      Periodo: <%= AcademicPeriod.current&.name || "No definido" %>
    </span>
  </div>

  <%# Grid de los 4 Módulos Oficiales del Layout %>
  <div class="row g-4 mb-5">
    
    <%# Módulo 1: Alumnos %>
    <div class="col-md-6 col-lg-3">
      <div class="card h-100 border-0 shadow-sm hover-shadow transition-all bg-white rounded-4 p-3">
        <div class="card-body p-3 text-center d-flex flex-column justify-content-between">
          <div>
            <div class="bg-primary-subtle rounded-circle d-inline-flex align-items-center justify-content-center mb-3 text-primary" style="width: 65px; height: 65px;">
              <i class="bi bi-mortarboard" style="font-size: 1.8rem;"></i>
            </div>
            <h5 class="fw-bold text-slate">Alumnos</h5>
            <p class="text-muted small">Inscripciones, expedientes y retiros.</p>
          </div>
          <div class="mt-3">
            <%= link_to "Supervisar Alumnos", alumnos_path, class: "btn btn-outline-primary w-100 rounded-pill fw-semibold" %>
          </div>
        </div>
      </div>
    </div>

    <%# Módulo 2: Representantes %>
    <div class="col-md-6 col-lg-3">
      <div class="card h-100 border-0 shadow-sm hover-shadow transition-all bg-white rounded-4 p-3">
        <div class="card-body p-3 text-center d-flex flex-column justify-content-between">
          <div>
            <div class="bg-success-subtle rounded-circle d-inline-flex align-items-center justify-content-center mb-3 text-success" style="width: 65px; height: 65px;">
              <i class="bi bi-people" style="font-size: 1.8rem;"></i>
            </div>
            <h5 class="fw-bold text-slate">Representantes</h5>
            <p class="text-muted small">Informacion de contacto legal y parentesco.</p>
          </div>
          <div class="mt-3">
            <%= link_to "Ver Representantes", representantes_path, class: "btn btn-outline-success w-100 rounded-pill fw-semibold" %>
          </div>
        </div>
      </div>
    </div>

    <%# Módulo 3: Recursos Humanos (RRHH) %>
    <div class="col-md-6 col-lg-3">
      <div class="card h-100 border-0 shadow-sm hover-shadow transition-all bg-white rounded-4 p-3">
        <div class="card-body p-3 text-center d-flex flex-column justify-content-between">
          <div>
            <div class="bg-warning-subtle rounded-circle d-inline-flex align-items-center justify-content-center mb-3 text-warning" style="width: 65px; height: 65px;">
              <i class="bi bi-person-badge" style="font-size: 1.8rem;"></i>
            </div>
            <h5 class="fw-bold text-slate">Personal / RRHH</h5>
            <p class="text-muted small">Fichas técnicas de personal docentes, administrativos y obreros.</p>
          </div>
          <div class="mt-3">
            <%= link_to "Gestionar Personal", rrhh_path, class: "btn btn-outline-warning w-100 rounded-pill fw-semibold text-dark" %>
          </div>
        </div>
      </div>
    </div>

    <%# Módulo 4: Administración Global %>
    <div class="col-md-6 col-lg-3">
      <div class="card h-100 border-0 shadow-sm hover-shadow transition-all bg-white rounded-4 p-3">
        <div class="card-body p-3 text-center d-flex flex-column justify-content-between">
          <div>
            <div class="bg-danger-subtle rounded-circle d-inline-flex align-items-center justify-content-center mb-3 text-danger" style="width: 65px; height: 65px;">
              <i class="bi bi-sliders" style="font-size: 1.8rem;"></i>
            </div>
            <h5 class="fw-bold text-slate">Consola Admin</h5>
            <p class="text-muted small">Configuración de asignaturas, niveles, periodos y aulas y más.</p>
          </div>
          <div class="mt-3">
            <%= link_to "Panel de Control", zadmin_path, class: "btn btn-outline-danger w-100 rounded-pill fw-semibold" %>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<%# CSS Limpio y Estructurado %>
<style>
  .text-slate { color: #1e293b !important; }
  .transition-all { transition: all 0.25s ease-in-out; }
  
  .hover-shadow:hover {
    transform: translateY(-5px);
    box-shadow: 0 1rem 3rem rgba(0,0,0,0.08) !important;
  }

  .btn-outline-primary:hover { background-color: #0d6efd !important; color: white !important; }
  .btn-outline-success:hover { background-color: #198754 !important; color: white !important; }
  .btn-outline-warning:hover { background-color: #ffc107 !important; color: black !important; }
  .btn-outline-danger:hover { background-color: #dc3545 !important; color: white !important; }
</style>