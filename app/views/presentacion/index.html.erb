<div class="container mt-4 mb-5">
  <%# Hero Section: Estilo Cover Profesional %>
  <div class="p-5 mb-5 rounded-5 shadow-lg position-relative overflow-hidden border-0" 
       style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
    
    <%# Decoración abstracta de fondo %>
    <div class="position-absolute top-0 end-0 p-5 opacity-10 d-none d-lg-block" style="transform: rotate(15deg);">
       <span style="font-size: 20rem;">🏛️</span>
    </div>

    <div class="row align-items-center position-relative" style="z-index: 2;">
      <div class="col-lg-7 text-center text-lg-start">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb mb-3 justify-content-center justify-content-lg-start">
            <li class="breadcrumb-item text-primary fw-bold text-uppercase small" style="letter-spacing: 1px;">Portal Informativo</li>
            <li class="breadcrumb-item active small" aria-current="page">SICEIN</li>
          </ol>
        </nav>
        
        <h1 class="display-3 fw-bolder text-dark mb-3 tracking-tight">
          Educación Inicial <br>
          <span class="text-primary">con excelencia.</span>
        </h1>
        
        <p class="lead text-secondary mb-4 fs-4 pe-lg-5">
          Plataforma integral para el Centro de Educación Inicial. Un espacio diseñado para la eficiencia administrativa y el seguimiento pedagógico.
        </p>

        <div class="d-flex flex-column flex-md-row gap-3 justify-content-center justify-content-lg-start mt-4">
          <% if authenticated? %>
            <%= link_to "Ir a mi Panel", user_dashboard_path, class: "btn btn-primary btn-lg px-5 rounded-pill shadow-sm fw-bold" %>
            <%= link_to "Noticias Institucionales", noticias_info_path, class: "btn btn-outline-dark btn-lg px-4 rounded-pill" %>
            <%= link_to "Vision y Mision", vision_mision_info_path, class: "btn btn-outline-dark btn-lg px-4 rounded-pill" %>
            <%= link_to "Consulta Publica", consulta_publica_info_path, class: "btn btn-outline-dark btn-lg px-4 rounded-pill" %>
          <% else %>
            <%= link_to "Acceder al Sistema", new_session_path, class: "btn btn-primary btn-lg px-5 rounded-pill shadow-sm fw-bold" %>
            <%= link_to "Noticias Institucionales", noticias_info_path, class: "btn btn-outline-dark btn-lg px-4 rounded-pill" %>
            <%= link_to "Vision y Mision", vision_mision_info_path, class: "btn btn-outline-dark btn-lg px-4 rounded-pill" %>
            <%= link_to "Consulta Publica", consulta_publica_info_path, class: "btn btn-outline-dark btn-lg px-4 rounded-pill" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div id="features" class="row g-0 text-center mt-2">
    <div class="col-14 mb-2">
      <h3 class="fw-bold">Pilares de Nuestra Gestion:</h3>
    </div>
    <div class="col-md-4">
      <div class="p-4 rounded-4 bg-white shadow-sm border h-100 transition-up">
        <div class="mb-2 text-primary h1 text-opacity-75">🏢</div>
        <h5 class="fw-bold">Institucional</h5>
        <p class="text-muted small mb-0">Centralización de datos fundamentales del Centro Educativo y su estructura organizacional.</p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="p-4 rounded-4 bg-white shadow-sm border h-100 transition-up">
        <div class="mb-2 text-success h1 text-opacity-75">👨‍👩‍👧‍👦</div>
        <h5 class="fw-bold">Comunidad</h5>
        <p class="text-muted small mb-0">Vinculación efectiva entre representantes, alumnos y el personal docente.</p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="p-4 rounded-4 bg-white shadow-sm border h-100 transition-up">
        <div class="mb-2 text-warning h1 text-opacity-75">📊</div>
        <h5 class="fw-bold">Transparencia</h5>
        <p class="text-muted small mb-0">Herramientas precisas para el control de asistencia y evaluaciones académicas.</p>
      </div>
    </div>
  </div>
</div>

<style>
  .transition-up {
    transition: all 0.3s ease;
  }
  .transition-up:hover {
    transform: translateY(-10px);
    box-shadow: 0 1rem 3rem rgba(0,0,0,.1) !important;
  }
  .tracking-tight {
    letter-spacing: -1.5px;
  }
</style>