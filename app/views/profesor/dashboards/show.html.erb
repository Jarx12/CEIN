<div class="container py-4">
  <%# Encabezado de Bienvenida %>
  <div class="row mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm bg-primary text-white rounded-4 p-4">
        <div class="d-flex align-items-center gap-3">
          <div class="bg-white rounded-circle p-3 text-primary shadow-sm">
            <span style="font-size: 2rem;">👩‍🏫</span>
          </div>
          <div>
            <h1 class="h3 mb-1 fw-bold">¡Hola, Prof. <%= @docente.name %>!</h1>
            <p class="mb-0 opacity-75">Bienvenido al sistema de control académico SICEIN.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="d-flex justify-content-between align-items-end mb-4">
    <div>
    <h3 class="fw-bold text-dark mb-0">Tus Secciones</h3>    
    </div>
    <span class="badge bg-warning text-dark">
        Periodo: <%= AcademicPeriod.current&.name %>
    </span>
  </div>
    </div>
  <%# Grid de Secciones %>
  <div class="row g-4">
    <% if @secciones.any? %>
      <% @secciones.each do |seccion| %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-2 shadow-sm rounded-4 overflow-hidden hover-shadow transition">
            <div class="card-header border-0 bg-white pt-4 px-4 pb-0">
              <h5 class="card-title fw-bold text-primary mb-1">
                Sección: <%= seccion.nombre_seccion %>
              </h5>
              <p class="text-muted small fw-medium mb-3">
                <i class="bi bi-mortarboard-fill"></i> Nivel: <%= seccion.nivel.nombre_nivel %>
              </p>
            </div>

            <div class="card-body px-4">
              <div class="d-flex justify-content-between mb-3 bg-light rounded-3 p-3">
                <div class="text-center">
                  <span class="d-block text-muted small fw-bold">SALÓN</span>
                  <span class="fw-bold text-dark"><%= seccion.numero_salon %></span>
                </div>
                <div class="vr text-muted opacity-25"></div>
                <div class="text-center">
                  <span class="d-block text-muted small fw-bold">INSCRITOS</span>
                  <span class="fw-bold text-dark"><%= seccion.current_enrollments.count %></span>
                </div>
              </div>

              <div class="list-group list-group-flush small border-top pt-2">
                <div class="list-group-item border-0 px-0 d-flex justify-content-between align-items-center">
                  <span class="text-muted">Inscritos:</span>
                  <span class="badge bg-info-subtle text-black rounded-pill px-2">
                    <%= seccion.current_enrollments.count %> Alumnos
                  </span>
                </div>
              </div>
            </div>

            <div class="card-footer border-0 bg-white p-4 pt-0">
              <div class="d-grid gap-2">
                <%= link_to profesor_seccion_path(seccion), class: "btn btn-success rounded-pill fw-bold d-flex align-items-center justify-content-center gap-2" do %>
                  <i class="bi bi-pencil-square"></i> Ver Sección
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="col-12">
        <div class="text-center py-5 bg-white rounded-4 shadow-sm">
          <span style="font-size: 3rem;">📭</span>
          <p class="mt-3 text-muted">No tienes secciones asignadas para este periodo.</p>
        </div>
      </div>
    <% end %>
      <%# Botón de Inicio al final %>
  <div class="mt-5 d-flex justify-content-center">
    <%= link_to root_path, class: "btn btn-link text-decoration-none text-muted d-flex align-items-center gap-2" do %>
      🏠 <span>Volver al Inicio</span>
    <% end %>
  </div>
</div>

<style>
  .hover-shadow {
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .hover-shadow:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
  }
  .bg-primary {
    background-color: #0d6efd !important;
  }
  .text-primary {
    color: #FA846E !important;
  }
</style>